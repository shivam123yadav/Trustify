# MongoDB Atlas or Local Connection URI
# Replace <db_username> and <db_password> with your MongoDB database user credentials.
# If password contains special characters, ensure they are URL-encoded.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/trustify?retryWrites=true&w=majority

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Flask Secret Key for session signing
FLASK_SECRET_KEY=your_flask_secret_key_here

# Gemini Model Identifier
GEMINI_MODEL=gemini-3.5-flash-lite
